{
  "name": "@moretea-labs/forge-design",
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate:design && npm run typecheck && vite build",
    "typecheck": "npm run check:schema-types && tsc --noEmit -p tsconfig.app.json --pretty false",
    "test": "vitest run --maxWorkers=1",
    "validate:design": "node scripts/validate-design-system.mjs",
    "design": "node scripts/design.mjs",
    "generate:schema-types": "node scripts/generate-schema-types.mjs",
    "check:schema-types": "node scripts/generate-schema-types.mjs --check"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "description": "Repository-native product and UI design workspace with Product Contracts, Golden gates, and a Forge external provider.",
  "license": "MIT",
  "homepage": "https://github.com/moretea-labs/forge-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moretea-labs/forge-design.git"
  },
  "bugs": {
    "url": "https://github.com/moretea-labs/forge-design/issues"
  },
  "bin": {
    "forge-design": "scripts/design.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
