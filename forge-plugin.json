{
  "$schema": "./schemas/forge-plugin.schema.json",
  "id": "design",
  "name": "Forge Design",
  "version": "0.6.0",
  "mode": "external",
  "canonicalStorage": ".design-harness",
  "repoHarnessAdapter": null,
  "entrypoints": {
    "web": "npm run dev",
    "cli": "forge-design",
    "provider": "scripts/forge-provider.mjs"
  },
  "capabilities": [
    "design.projects",
    "design.read",
    "design.write"
  ],
  "protocolVersion": "1.0",
  "scope": "controller",
  "provider": "moretea-labs",
  "repositoryRegistrationRequired": false,
  "transport": {
    "kind": "managed-cli-json",
    "entrypoint": "scripts/forge-provider.mjs"
  },
  "actions": [
    "design_list_projects",
    "design_register_project",
    "design_get_context",
    "design_get_product_model",
    "design_put_product_model",
    "design_get_design_units",
    "design_put_design_units",
    "design_get_tokens",
    "design_put_tokens",
    "design_get_components",
    "design_put_components",
    "design_list_screens",
    "design_get_screen",
    "design_create_screen",
    "design_put_screen",
    "design_get_product_flow",
    "design_put_product_flow",
    "design_put_artboard",
    "design_get_review_status",
    "design_accept_unit",
    "design_freeze_project",
    "design_migrate_project",
    "design_validate",
    "design_export_markdown",
    "design_import_markdown"
  ]
}
