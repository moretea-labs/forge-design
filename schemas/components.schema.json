{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-harness.local/design-harness/components.schema.json",
  "title": "Design Harness component contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose", "allowedProps", "category"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "purpose": { "type": "string", "minLength": 1 },
          "allowedProps": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "category": { "enum": ["layout", "content", "control", "navigation"] }
        }
      }
    }
  }
}
