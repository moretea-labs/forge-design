{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-harness.local/design-harness/screen.schema.json",
  "title": "Design Harness screen specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "goal",
    "primaryAction",
    "constraints",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "enum": [
        "iphone-16-pro"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "primaryAction": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "props": {
            "type": "object"
          },
          "variant": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "state": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "interactionPatternId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event",
                "actions"
              ],
              "properties": {
                "event": {
                  "enum": [
                    "press",
                    "change",
                    "submit",
                    "select",
                    "toggle"
                  ]
                },
                "actions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "set_state",
                          "toggle",
                          "select",
                          "navigate",
                          "back",
                          "open_overlay",
                          "close_overlay",
                          "set_input",
                          "submit_mock",
                          "scroll_to",
                          "emit_design_action"
                        ]
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string"
                      },
                      "screenId": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      },
                      "stateId": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      },
                      "overlayId": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      },
                      "targetId": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      },
                      "actionId": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "initialStateId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "meaning"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "primaryAction": {
            "type": "string",
            "minLength": 1
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "component"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "props": {
                  "type": "object"
                },
                "variant": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "state": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "interactionPatternId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "interactions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "event",
                      "actions"
                    ],
                    "properties": {
                      "event": {
                        "enum": [
                          "press",
                          "change",
                          "submit",
                          "select",
                          "toggle"
                        ]
                      },
                      "actions": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type"
                          ],
                          "properties": {
                            "type": {
                              "enum": [
                                "set_state",
                                "toggle",
                                "select",
                                "navigate",
                                "back",
                                "open_overlay",
                                "close_overlay",
                                "set_input",
                                "submit_mock",
                                "scroll_to",
                                "emit_design_action"
                              ]
                            },
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "value": {
                              "type": "string"
                            },
                            "screenId": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9_-]*$"
                            },
                            "stateId": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9_-]*$"
                            },
                            "overlayId": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9_-]*$"
                            },
                            "targetId": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9_-]*$"
                            },
                            "actionId": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9_-]*$"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "safeTop",
        "safeBottom"
      ],
      "properties": {
        "kind": {
          "enum": [
            "device",
            "desktop",
            "web"
          ]
        },
        "platform": {
          "enum": [
            "ios",
            "android",
            "macos",
            "windows",
            "web",
            "other"
          ]
        },
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "number",
          "minimum": 1
        },
        "height": {
          "type": "number",
          "minimum": 1
        },
        "safeTop": {
          "type": "number",
          "minimum": 0
        },
        "safeBottom": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredStateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "requireTokenReferences": {
          "type": "boolean"
        },
        "minimumHitTarget": {
          "type": "number",
          "minimum": 1
        }
      }
    }
  }
}
